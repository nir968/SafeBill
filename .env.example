DATABASE_URL=postgresql+asyncpg://safebill:password@localhost:5432/safebill
REDIS_URL=redis://localhost:6379/0

# No default in app/config.py on purpose - the app refuses to start
# without a real value, rather than silently signing every session token
# with a well-known fallback. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Same reasoning/no-default as SECRET_KEY above - the shared secret
# telegram_bot.py presents to prove it's the trusted bot process (see
# app/auth.py::get_authorized_user_id). Generate the same way:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and set the identical value in this file AND wherever telegram_bot.py
# itself reads its own .env from.
INTERNAL_API_KEY=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

MAX_CONCURRENT_EXTRACTIONS=8
MAX_UPLOAD_BYTES=10485760
VLM_TIMEOUT_SECONDS=15.0

# The same token telegram_bot.py polls with (from @BotFather) - a bot
# token authenticates any caller to send as that bot, so the worker's
# outbound alerts and the bot's inbound polling can share one token
# across two separate processes. Left as "mock-token", the worker logs a
# clear "not configured" warning per alert attempt instead of trying to
# send and failing.
TELEGRAM_BOT_TOKEN=mock-token
# Optional, for your own reference only - the app never reads this value.
# Your personal numeric Telegram user ID (e.g. 945111111, not your
# @username); message @userinfobot on Telegram to get it. Handy when
# testing the bot's API calls by hand, which pass it as ?user_id=. You do
# NOT need it to link accounts: the dashboard's "Connect Telegram" button
# picks up your ID automatically.
telegram_id=

# Your bot's public @username (no @ prefix) - from @BotFather, not
# derivable from TELEGRAM_BOT_TOKEN above (that authenticates API calls;
# it doesn't reveal the public username). Only used to build the
# dashboard's "Connect Telegram" deep link (t.me/<username>?start=...) -
# leave blank to simply not show that button yet.
TELEGRAM_BOT_USERNAME=

# Optional - real email delivery for POST /auth/forgot-password (see
# app/email_client.py). Leave all four blank to keep the original mocked
# behavior: the reset link is written to the server log instead of
# emailed, which is exactly what happens if any one of these is missing.
# SMTP_USERNAME and FROM_EMAIL are typically the same Gmail address.
# SMTP_PASSWORD MUST be a Gmail *App Password*, not your real Gmail
# password - Gmail rejects normal password auth for SMTP entirely.
# Create one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Which AI reads uploaded bills: "gemini" or "anthropic". Swapping this
# (plus that provider's API key below) is the only change needed.
VISION_PROVIDER=gemini

# Read directly by the anthropic SDK (not by app.config.Settings) — the
# zero-arg AsyncAnthropic() client picks this up from the process env.
# Required when VISION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Read directly by the google-genai SDK (not by app.config.Settings) — the
# zero-arg genai.Client() picks this up from the process env.
# Required when VISION_PROVIDER=gemini. Never commit a real value — this
# file is a template; put the real key in a git-ignored .env only.
GEMINI_API_KEY=
# Google has retired or new-project-blocked several flash-tier model IDs
# in quick succession — this is a Settings field specifically so a future
# retirement is an env var change, not a code edit.
GEMINI_MODEL=gemini-3-flash-preview

# Optional - the free UserWay accessibility widget (see dashboard.html).
# Leave blank to simply not render it; get a real value from your own
# account at userway.org.
USERWAY_ACCOUNT_ID=

# --- Production only (docker-compose.prod.yml / init-letsencrypt.sh) ---
# Not read by app.config.Settings at all - these are consumed directly
# by docker-compose.prod.yml's own variable interpolation and by
# init-letsencrypt.sh, not by the FastAPI app itself.

# Your real domain, once purchased and pointed at this server (A/AAAA
# record) - the one place it needs to be set; flows into nginx's config
# and the certbot request automatically from here. Leave unset for local
# dev - docker-compose.yml (the dev file) doesn't use it at all.
DOMAIN=

# Let's Encrypt uses this for expiry/security notices only - not
# published anywhere, doesn't need to be a monitored inbox.
CERTBOT_EMAIL=

# Postgres credentials for docker-compose.prod.yml's db service -
# separate from DATABASE_URL above, which docker-compose.prod.yml
# overrides internally to always point at the `db` service by name (see
# that file's own comments). Pick a real password before going to
# production - "password" (this file's own local-dev example above) is
# not a real credential.
POSTGRES_USER=safebill
POSTGRES_PASSWORD=
POSTGRES_DB=safebill

